[
  {
    "id": "LNX-AUTH-001",
    "title": "SSH failed password",
    "description": "Detects repeated failed SSH password attempts from a single IP. Triggers HIGH for external IPs and MEDIUM for RFC1918 internal IPs.",
    "platform": "linux",
    "enabled": true,
    "log_type": "auth",
    "category": "brute_force",
    "check": 1,
    "regex": "sshd(?:\\[\\d+\\])?: Failed password for (?:invalid user )?(?P<user>\\S+) from (?P<ip>\\d{1,3}(?:\\.\\d{1,3}){3})",
    "flags": [],
    "group_by": "ip",
    "count_distinct": null,
    "threshold": 6,
    "window_minutes": 60,
    "severity": "HIGH",
    "severity_internal": "MEDIUM",
    "mitre": ["T1110.001"],
    "references": ["sigma:lnx_sshd_failed_logins", "mitre:T1110.001"],
    "tests": {
      "match": [
        "Jan 15 03:41:09 centos-web01 sshd: Failed password for invalid user admin from 203.0.113.17 port 51022 ssh2",
        "Jan 15 03:41:12 centos-web01 sshd[2211]: Failed password for root from 203.0.113.17 port 40211 ssh2"
      ],
      "no_match": [
        "Jan 15 03:42:11 centos-web01 sshd[2240]: Accepted password for analyst from 203.0.113.17 port 54321 ssh2",
        "Jan 15 03:42:15 centos-web01 sshd[2240]: pam_unix(sshd:session): session opened for user analyst by (uid=0)"
      ]
    }
  },
  {
    "id": "LNX-AUTH-002",
    "title": "SSH login accepted",
    "description": "Matches successful SSH logins. Person 3 correlates this with prior failures for Check 2.",
    "platform": "linux",
    "enabled": true,
    "log_type": "auth",
    "category": "credential_access",
    "check": 2,
    "regex": "sshd(?:\\[\\d+\\])?: Accepted (?P<method>password|publickey|keyboard-interactive(?:/pam)?) for (?P<user>\\S+) from (?P<ip>\\d{1,3}(?:\\.\\d{1,3}){3})",
    "flags": [],
    "group_by": "ip",
    "count_distinct": null,
    "threshold": 1,
    "window_minutes": null,
    "severity": "HIGH",
    "severity_internal": "MEDIUM",
    "mitre": ["T1110", "T1078"],
    "references": ["sigma:lnx_ssh_login_accepted"],
    "tests": {
      "match": [
        "Jan 15 03:42:11 centos-web01 sshd[2240]: Accepted password for analyst from 203.0.113.42 port 54321 ssh2",
        "Jan 15 03:42:20 centos-web01 sshd: Accepted publickey for root from 192.168.56.10 port 45222 ssh2"
      ],
      "no_match": [
        "Jan 15 03:41:09 centos-web01 sshd[2211]: Failed password for root from 203.0.113.42 port 40211 ssh2",
        "Jan 15 03:41:15 centos-web01 sshd[2211]: Connection closed by 203.0.113.42 port 40211 [preauth]"
      ]
    }
  },
  {
    "id": "LNX-AUTH-003",
    "title": "sudo command",
    "description": "Matches sudo command executions. Overlaps with failure rule LNX-AUTH-004 when user is not in sudoers.",
    "platform": "linux",
    "enabled": true,
    "log_type": "auth",
    "category": "privilege_escalation",
    "check": 3,
    "regex": "sudo(?:\\[\\d+\\])?:\\s+(?P<user>\\S+)\\s*:\\s*(?:(?P<not_in_sudoers>user NOT in sudoers)\\s*;\\s*)?TTY=(?P<tty>\\S+)\\s*;\\s*PWD=(?P<pwd>\\S+)\\s*;\\s*USER=(?P<target_user>\\S+)\\s*;\\s*COMMAND=(?P<cmd>.+)",
    "flags": [],
    "group_by": null,
    "count_distinct": null,
    "threshold": 1,
    "window_minutes": null,
    "severity": "HIGH",
    "mitre": ["T1548.003"],
    "references": ["sigma:lnx_sudo_execution"],
    "tests": {
      "match": [
        "Nov 25 10:15:30 centos-web01 sudo:  analyst : TTY=pts/0 ; PWD=/home/analyst ; USER=root ; COMMAND=/bin/id",
        "Nov 25 10:15:35 centos-web01 sudo[1422]: baduser : user NOT in sudoers ; TTY=pts/0 ; PWD=/tmp ; USER=root ; COMMAND=/bin/bash"
      ],
      "no_match": [
        "Nov 25 10:15:40 centos-web01 sudo: pam_unix(sudo:auth): authentication failure; logname=analyst uid=1000",
        "Nov 25 10:15:45 centos-web01 systemd: Started Session 1 of user analyst."
      ]
    }
  },
