  {
    "id": "LNX-AUD-001",
    "title": "sudo / su executed successfully (auditd)",
    "description": "Detects auditd record of successful sudo or su invocation via SYSCALL.",
    "platform": "linux",
    "enabled": true,
    "log_type": "audit",
    "category": "privilege_escalation",
    "check": 7,
    "regex": "type=SYSCALL\\b(?=[^\\n]*?\\bsuccess=yes)[^\\n]*?\\bcomm=\"(?P<comm>sudo|su)\"",
    "flags": [],
    "group_by": null,
    "count_distinct": null,
    "threshold": 1,
    "window_minutes": null,
    "severity": "HIGH",
    "mitre": ["T1548.003", "T1078"],
    "references": ["mitre:T1548.003"],
    "tests": {
      "match": [
        "type=SYSCALL msg=audit(1700000000.123:456): arch=c000003e syscall=59 success=yes exit=0 a0=7ffcd3 a1=7ffcd8 comm=\"sudo\" exe=\"/usr/bin/sudo\"",
        "type=SYSCALL msg=audit(1700000005.789:457): arch=c000003e syscall=59 success=yes exit=0 comm=\"su\" exe=\"/usr/bin/su\""
      ],
      "no_match": [
        "type=SYSCALL msg=audit(1700000010.123:458): arch=c000003e syscall=59 success=no exit=-13 comm=\"sudo\" exe=\"/usr/bin/sudo\"",
        "type=USER_AUTH msg=audit(1700000015.456:459): pid=123 uid=1000 auid=1000 res=success"
      ]
    }
  },
